PORT=5000
NODE_ENV=development

MONGO_URI=mongodb://127.0.0.1:27017/palm_pay

JWT_SECRET=replace_with_output_of:_node_-e_"console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_EXPIRES_IN=7d

ML_SERVICE_URL=http://127.0.0.1:8000
ML_SERVICE_TIMEOUT_MS=8000

# Keep in sync with palm_ml/config.py
MATCH_THRESHOLD_VERIFY=0.65
MATCH_THRESHOLD_IDENTIFY=0.78

RATE_LIMIT_LOGIN_WINDOW_MS=900000
RATE_LIMIT_LOGIN_MAX=5
RATE_LIMIT_PIN_WINDOW_MS=900000
RATE_LIMIT_PIN_MAX=5
RATE_LIMIT_PALM_REGISTER_WINDOW_MS=3600000
RATE_LIMIT_PALM_REGISTER_MAX=10
